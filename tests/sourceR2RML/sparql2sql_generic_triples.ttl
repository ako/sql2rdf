@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <http://example.com/ns#> .

# A generic triple map: subject, predicate and object all come from columns,
# as when an ontology is loaded as (subject, predicate, object) rows. Any
# property or class IRI can come out of it, so a vocabulary check must treat
# both sets as open and never report a term as unknown.
<#Triples>
    rr:logicalTable [ rr:tableName "TRIPLES" ] ;
    rr:subjectMap [ rr:column "S" ] ;
    rr:predicateObjectMap [
        rr:predicateMap [ rr:column "P" ] ;
        rr:objectMap [ rr:column "O" ; rr:termType rr:IRI ]
    ] .

<#Emp>
    rr:logicalTable [ rr:tableName "EMP" ] ;
    rr:subjectMap [ rr:template "http://data.example.com/employee/{EMPNO}" ; rr:class ex:Employee ] ;
    rr:predicateObjectMap [ rr:predicate ex:name ; rr:objectMap [ rr:column "ENAME" ] ] .
